{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Path Panda Configuration",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"patterns": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"name": {
						"type": "string",
						"description": "Label shown next to the emoji in the status bar."
					},
					"pattern": {
						"type": "string",
						"description": "Pattern matched against the full file path. Use '*' to match all files."
					},
					"match_case": {
						"type": "boolean",
						"description": "When true, matching is case-sensitive.",
						"default": false
					},
					"match_whole_word": {
						"type": "boolean",
						"description": "When true, only whole-word matches are allowed.",
						"default": true
					},
					"use_regex": {
						"type": "boolean",
						"description": "When true, pattern is treated as a regular expression.",
						"default": false
					},
					"emoji": {
						"type": "string",
						"description": "Emoji or short label shown before the name."
					},
					"color": {
						"description": "Text color. Hex value or a VS Code status bar foreground theme token. Defaults to statusBar.foreground.",
						"default": "statusBar.foreground",
						"oneOf": [
							{
								"type": "string",
								"description": "Hex text color. Examples: #fff, #ffffff, #ffffffff.",
								"format": "color-hex",
								"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
							},
							{
								"type": "string",
								"description": "VS Code status bar foreground theme token.",
								"enum": [
									"statusBar.foreground",
									"statusBarItem.errorForeground",
									"statusBarItem.warningForeground",
									"statusBarItem.prominentForeground",
									"statusBarItem.remoteForeground",
									"statusBarItem.offlineForeground"
								]
							}
						]
					},
					"background_color": {
						"type": "string",
						"description": "VS Code status bar background token. Defaults to statusBarItem.prominentBackground.",
						"enum": [
							"",
							"statusBarItem.prominentBackground",
							"statusBarItem.warningBackground",
							"statusBarItem.errorBackground",
							"statusBarItem.remoteBackground",
							"statusBarItem.offlineBackground"
						]
					}
				},
				"required": ["pattern"]
			}
		}
	}
}
